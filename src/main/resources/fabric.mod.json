{
	"schemaVersion": 1,
	"id": "replymod",
	"version": "${version}",
	"name": "ReplyMod",
	"description": "Adds a Reply Command that sends message to the last person who messaged you",
	"authors": [
		"Adelina"
	],
	"contact": {
		"homepage": "https://github.com/AdelinaM17n/ReplyMod",
		"sources": "https://github.com/AdelinaM17n/ReplyMod"
	},
	"license": "MPL-2.0",
	"icon": "assets/replymod/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"io.github.adelinam17n.replymod.client.ReplyModClient"
		]
	},
	"mixins": [
		"replymod.mixins.json",
		{
			"config": "replymod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "26.x",
		"java": ">=25",
		"fabric-api": "*"
	}
}